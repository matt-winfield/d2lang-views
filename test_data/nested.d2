# Example with nested entities and multiple views
infrastructure: "Cloud Infrastructure" {
    compute: "Compute Layer" {
        web: "Web Servers"
        api: "API Servers"
        workers: "Background Workers"
    }
    data: "Data Layer" {
        primary_db: "Primary Database"
        replica_db: "Read Replica"
        cache: "Redis Cache"
    }
    messaging: "Messaging" {
        queue: "Message Queue"
        events: "Event Bus"
    }
}

external: "External Services" {
    payment: "Payment Gateway"
    email: "Email Provider"
    cdn: "CDN"
}

infrastructure.compute.web -> infrastructure.compute.api
infrastructure.compute.api -> infrastructure.data.primary_db
infrastructure.data.primary_db -> infrastructure.data.replica_db: replication
infrastructure.compute.api -> infrastructure.data.cache
infrastructure.compute.api -> infrastructure.messaging.queue
infrastructure.messaging.queue -> infrastructure.compute.workers
infrastructure.compute.workers -> external.email
infrastructure.compute.api -> external.payment

layers: {
    data_flow: "Data Flow View" { #view
        infrastructure.compute.api
        infrastructure.data.primary_db
        infrastructure.data.replica_db
        infrastructure.data.cache
    }
    async_processing: "Async Processing View" { #view
        infrastructure.compute.api
        infrastructure.messaging.queue
        infrastructure.compute.workers
        external.email
    }
    external_integrations: { #view
        infrastructure.compute.api
        external.payment
        external.email
        external.cdn

        note: "All external API calls go through the API servers"
    }
}
